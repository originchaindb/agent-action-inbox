# OriginChainDB Cloud Free > Connect > Application API. Never commit a real key.
OC_BASE_URL=https://your-instance.free.originchain.ai
OC_TENANT=your-tenant
OC_BEARER=
OC_DB_USER=
OC_DB_KEY=
# Each running server needs its own namespace. One writer process only.
OC_NAMESPACE=agent_inbox

# Claude is the default. Select a model available to your API account that supports structured outputs.
AI_PROVIDER=claude
AI_MODEL=
ANTHROPIC_API_KEY=
# To use OpenAI: AI_PROVIDER=openai; AI_MODEL=<compatible-model>; OPENAI_API_KEY=<key>
OPENAI_API_KEY=

# One repository, chosen by the operator. Use a disposable demo repository first.
GITHUB_REPOSITORY=your-owner/your-demo-repo
# Fine-grained token: only the chosen repository, Issues read/write.
GITHUB_TOKEN=
# Execution starts disabled. Enable only after reviewing the repository setting.
ENABLE_GITHUB_EXECUTION=false

APP_ADDR=127.0.0.1:8087
APP_ORIGIN=http://127.0.0.1:8087
# Generate two different random secrets, at least 32 characters each.
# Reviewer key is entered into the UI. Agent key can only submit proposals.
REVIEWER_TOKEN=
AGENT_TOKEN=
